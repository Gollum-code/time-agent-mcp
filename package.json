    "claude",
    "time-awareness"
  ],
  "author": "time-agent-mcp contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gollum-code/time-agent-mcp.git"
  },
  "homepage": "https://github.com/Gollum-code/time-agent-mcp#readme",
